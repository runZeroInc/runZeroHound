<bid>33065</bid>
<cert>836068</cert>
<cpe>cpe:/a:ietf:md5
cpe:/a:ietf:x.509_certificate</cpe>
<cve>CVE-2004-2761</cve>
<cve>CVE-2005-4900</cve>
<cvss3_base_score>5.3</cvss3_base_score>
<cvss3_score_source>CVE-2004-2761</cvss3_score_source>
