</ReportItem>
<ReportItem port="0" svc_name="general" protocol="tcp" severity="0" pluginID="35716" pluginName="Ethernet Card Manufacturer Detection" pluginFamily="Misc.">
<agent>unix</agent>
<description>Each ethernet MAC address starts with a 24-bit Organizationally Unique Identifier (OUI). These OUIs are registered by IEEE.</description>
