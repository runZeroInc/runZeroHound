<ReportItem port="445" svc_name="cifs" protocol="tcp" severity="0" pluginID="10785" pluginName="Microsoft Windows SMB NativeLanManager Remote System Information Disclosure" pluginFamily="Windows">
<asset_inventory>True</asset_inventory>
