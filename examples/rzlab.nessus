Response Body :

&lt;!DOCTYPE html&gt;
&lt;html&gt;

&lt;head&gt;
&lt;META http-equiv=&quot;Content-Type&quot; content=&quot;text/html; charset=utf-8&quot;&gt;
&lt;META HTTP-EQUIV=&quot;Pragma&quot; CONTENT=&quot;no_cache&quot;&gt;
&lt;META NAME=&quot;ATEN International Co Ltd.&quot; CONTENT=&quot;(c) ATEN International Co Ltd. 2010&quot;&gt;
&lt;title&gt;Supermicro BMC Login&lt;/title&gt;
&lt;link rel=&quot;icon&quot; href=&quot;../images/logo.png&quot; type=&quot;image/png&quot;&gt;

&lt;style&gt;
    html {
        position: relative;
        min-height: 100%;
        overflow-x: hidden;
    }

    footer {
        position: absolute;
        bottom: 10px;
        width: 100%;
        color: #2878DB;
        margin-bottom: 0px;
        overflow: hidden;
    }

    ::selection {
        color:#14293b; background-color: #ffed7f
    }

    .login-form form {
        border-radius:10px 10px 10px 10px;
    }

    .input-group label {
        color: #c7c7c7;
        font-weight: normal;
    }

    .login-input {
        height: 26px;
        border-radius: 13px;
        border: solid 1px #19334a;
        background-color: #19334a;
        border-image: none !important;
        border-style: none !important;
        color:#c7c7c7;
    }

    .login-input.login-error {
        height: 26px;
        border-radius: 13px;
        border: solid 1px #fb69a3 !important;;
        background-color: #19334a;
