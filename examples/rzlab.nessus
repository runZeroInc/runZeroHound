<ReportItem port="0" svc_name="general" protocol="tcp" severity="3" pluginID="49052" pluginName="Cisco IOS Software Multiprotocol Label Switching Packet Vulnerability (cisco-sa-20100324-ldp)" pluginFamily="CISCO">
