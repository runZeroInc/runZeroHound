&lt;script type=&quot;text/javascript&quot; src=&quot;../js/jquery-3.5.1.min.js&quot;&gt;&lt;/script&gt;
&lt;script type=&quot;text/javascript&quot; src=&quot;../js/jquery.translate.js?v=1.3.6&quot;&gt;&lt;/script&gt;
&lt;script type=&quot;text/javascript&quot; src=&quot;../js/jquery.blockUI.js?v=1.3.6&quot;&gt;&lt;/script&gt;
&lt;script type=&quot;text/javascript&quot; src=&quot;../js/bootstrap-4.3.1.web.min.js&quot;&gt;&lt;/script&gt;
&lt;script type=&quot;text/javascript&quot; src=&quot;../js/redfish.js?v=1.3.6&quot;&gt;&lt;/script&gt;
&lt;script src=&quot;../js/commonUtil.js?v=1.3.6&quot;&gt;&lt;/script&gt;

&lt;script&gt;
if (window != top) {
    top.location.href = &quot;/&quot;;
}

jQuery(document).ready (function($){

    if (!localStorage.getItem (&quot;language&quot;)) {
        localStorage.setItem (&apos;language&apos;, &quot;en&quot;);
    }
    updateLocalDictionary (false, localStorage.getItem (&quot;language&quot;));

    $.ajax ({
        url: &quot;../css/coreui-docs.min.css?v=1.3.6&quot;,
        dataType: &apos;text&apos;,
        async: false,
        cache: true,
        success: function(data) {
            $(&apos;&lt;style type=&quot;text/css&quot;&gt;\n&apos; + data + &apos;&lt;/style&gt;&apos;).appendTo(&quot;head&quot;);
        }
    });

    sessionStorage.clear();
    localStorage.removeItem (&quot;thisPage&quot;);
    localStorage.removeItem (&quot;isUpdateMode&quot;);

    initLanguage ();
    msieversion ();
    try {

        $.ajax ({
            url: &quot;../css/kendo.default.min.css?v=26&quot;,
            dataType: &apos;text&apos;,
            cache: false,
            success: function(data) {
                sessionStorage.setItem(&quot;kendoStyle&quot;, data);
            },  error: function(XMLHttpRequest, textStatus, errorThrown) {
                console.log (&quot;Status: &quot; + textStatus);
                console.log (&quot;Error: &quot; + errorThrown);
            }
        });

        $.ajax ({
            url: &quot;../css/commonStyle.css?v=26&quot;,
            dataType: &apos;text&apos;,
            cache: false,
            success: function(data) {
                sessionStorage.setItem(&quot;commonStyle&quot;, data);
            }
        });

    } catch (e) {}
    if (localStorage.getItem (&apos;auth&apos;) != null ) {
        jQuery(&apos;body&apos;).css(&apos;background-image&apos;, &apos;&apos;);
        sessionStorage.setItem (&apos;_x_auth&apos;  , localStorage.getItem (&apos;auth&apos;));
        sessionStorage.setItem (&apos;_sess_idx&apos;, localStorage.getItem (&apos;idx&apos;));
        top.location.href =&quot;../cgi/url_redirect.cgi?url_name=topmenu&quot;;
    } else {
        jQuery(&quot;#bodycontainer&quot;).css(&quot;display&quot;,&quot;block&quot;);
        var msg = document.getElementById (&quot;login_word&quot;);
        msg.setAttribute (&quot;value&quot;, &quot;Login&quot;);
    }
    jQuery(&quot;#copyRightYear&quot;).html (&apos;&amp;copy; &apos;+new Date().getFullYear());

    if (typeof localStorage.getItem (&quot;loginFail&quot;) == &quot;string&quot;  &amp;&amp; localStorage.getItem (&quot;loginFail&quot;) != &quot;&quot;) {
        $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;block&quot;);
        $(&quot;.warningDesc&quot;).text(translator.g(localStorage.getItem (&quot;loginFail&quot;)));
        localStorage.removeItem(&quot;loginFail&quot;);
    }

    if (typeof localStorage.getItem (&quot;timeoutStr&quot;) == &quot;string&quot;  &amp;&amp; localStorage.getItem (&quot;timeoutStr&quot;) != &quot;&quot;) {
        showErrModal(localStorage.getItem (&quot;timeoutStr&quot;));
        localStorage.removeItem(&quot;timeoutStr&quot;);
    }

    return;
});


function checkform ()
{
    if (trim(form1.name.value) == &quot;&quot;)
    {
        $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;block&quot;);
        $(&quot;.warningDesc&quot;).text(translator.g(&quot;LANG_LOGIN_INVALID_USERNAME&quot;))
        form1.name.focus();
        $(&quot;#usrName&quot;).addClass(&quot;login-error&quot;);
        return;
    } else {
        $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;none&quot;);
        $(&quot;#usrName&quot;).removeClass(&quot;login-error&quot;);
    }

    if (trim(form1.pwd.value) == &quot;&quot;)
    {
        $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;block&quot;);
        $(&quot;.warningDesc&quot;).text(translator.g(&quot;LANG_LOGIN_INVALID_PASSWORD&quot;));
        form1.pwd.focus();
        $(&quot;#pwd&quot;).addClass(&quot;login-error&quot;);
        return;
    } else {
        $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;none&quot;);
        $(&quot;#pwd&quot;).removeClass(&quot;login-error&quot;);
    }

    let isRedLogin = true;
    let ouser = localStorage.getItem(&quot;userID&quot;);

    if (trim(form1.name.value) != ouser ) {

        if (localStorage.getItem (&apos;auth&apos;) != null ) {

            let idx = localStorage.getItem (&apos;idx&apos;);
            let auth = localStorage.getItem (&apos;auth&apos;);

            let redObj = new Redfish (null, auth);
            redObj.logout (idx, false, false);

            localStorage.removeItem(&apos;auth&apos;);
            localStorage.removeItem(&apos;idx&apos;);
        }

        var redfishObj = new Redfish ();
            redfishObj.login (  form1.name.value,
                                form1.pwd.value,
                                null,
                                function (res, st, jqxhr)
                                {
                                    isRedLogin = false;
                                    if (res.status == 401 || res.status == 403) {
                                        localStorage.setItem(&quot;loginFail&quot;,&quot;LANG_EVENT_SENSOR_SPECIFIC_EVENT_STR42_2&quot;);
                                    }
                                    top.location.href = &quot;/&quot;;
                                }
            );

    } else {

        if (localStorage.getItem (&apos;auth&apos;) != null ) {
            sessionStorage.setItem (&apos;_x_auth&apos;  , localStorage.getItem (&apos;auth&apos;));
            sessionStorage.setItem (&apos;_sess_idx&apos;, localStorage.getItem (&apos;idx&apos;));

        } else {

            var redfishObj = new Redfish ();
                redfishObj.login (  form1.name.value,
                                    form1.pwd.value,
                                    null,
                                    function (res, st, jqxhr)
                                    {
                                        isRedLogin = false;
                                        if (res.status == 401 || res.status == 403) {
                                            localStorage.setItem(&quot;loginFail&quot;,&quot;LANG_EVENT_SENSOR_SPECIFIC_EVENT_STR42_2&quot;);
                                        }
                                        top.location.href = &quot;/&quot;;
                                    }
                );
        }
    }

    if (isRedLogin) {

        if ($(&quot;.pwdEyeCss.closeEyeCss&quot;).length &gt; 0) {
            document.querySelector(&apos;.pwdEyeCss.closeEyeCss&apos;).click();
        }

        $.ajax ({
            type: &quot;POST&quot;,
            url: &quot;/cgi/login.cgi&quot;,
            data: &quot;?name=&quot; + escapeBtoaChars(btoa (form1.name.value)) +
                  &quot;&amp;pwd=&quot; + escapeBtoaChars(btoa (form1.pwd.value)) +
                  &quot;&amp;check=00&quot;
        })
        .done (function(d) {
            $(document.body).append (d);
        });

        return;
    }
}

function checkEnt (e)
{
    var key = window.event ? e.keyCode : e.which;
    if(key == 13)
    {
        checkform();
    }
}

function chkRequired()
{
    $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;none&quot;);
    $(&quot;.warningDesc&quot;).text(&quot;&quot;);
    if (trim(form1.name.value) !== &quot;&quot;)
    {
        $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;none&quot;);
        $(&quot;#usrName&quot;).removeClass(&quot;login-error&quot;);
    }

    if (trim(form1.pwd.value) !== &quot;&quot;)
    {
        $(&quot;.warningText&quot;).css(&quot;display&quot;,&quot;none&quot;);
        $(&quot;#pwd&quot;).removeClass(&quot;login-error&quot;);
    }
}

function msieversion ()
{
    let ua = window.navigator.userAgent;
    let msie = ua.indexOf(&quot;MSIE &quot;);
    if (msie &gt; 0 || !!navigator.userAgent.match(/Trident.*rv\:11\./))
    {
        $(&quot;#loginModalCenter&quot;).modal (&apos;show&apos;);
    }
    return false;
}

function escapeBtoaChars (str)
{
    return str.replace(/\+/g, &quot;%2b&quot;);
}

function showErrModal (str)
{
    $(&quot;#loginErrModal&quot;).modal(&quot;show&quot;);
    $(&quot;#errStr&quot;).html(str);
}

function closeModal()
{
    $(&quot;#loginErrModal&quot;).modal(&quot;hide&quot;);
}

&lt;/script&gt;


&lt;/head&gt;
&lt;div id=&quot;bodycontainer&quot; style=&quot;display:none&quot;&gt;
&lt;body style=&quot;background: url(../images/login.png?v=D) center center fixed no-repeat;margin:0px;padding-bottom: 15px;background-size: cover;&quot;&gt;
    &lt;div class=&quot;container&quot;&gt;
        &lt;div class=&quot;d-flex justify-content-center align-items-center&quot; style=&quot;margin-top: 10%;&quot;&gt;
            &lt;div style=&quot;min-width: 340px&quot;&gt;
                &lt;div style=&quot;text-align: center;&quot;&gt;
                    &lt;img src=&quot;../images/logo.png?v=D&quot; style=&quot;padding-bottom:30px; width:190px;margin-right:41px&quot;&gt;
                &lt;/div&gt;
                &lt;div&gt;
                    &lt;form name=&quot;form1&quot; id=&quot;form1&quot; action=&quot;/cgi/login.cgi&quot; method=&quot;post&quot; autocomplete=&quot;off&quot;&gt;
                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;div class=&quot;input-group&quot;&gt;
                                &lt;label class=&quot;trn col-3&quot; data-trn-key=&quot;LANG_LOGIN_USERNAME&quot; style=&quot;padding:0px;margin-right:-10px&quot;&gt;&lt;/label&gt;
                                &lt;input type=&quot;text&quot; class=&quot;login-input col-8&quot; name=&quot;name&quot; id=&quot;usrName&quot; onKeyDown=&quot;checkEnt(event)&quot; onChange=&quot;chkRequired()&quot; required=&quot;required&quot;&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;div class=&quot;input-group password-icons&quot;&gt;
                                &lt;label class=&quot;trn col-3&quot; data-trn-key=&quot;LANG_LOGIN_PASSWORD&quot; style=&quot;padding:0px;margin-right:-10px&quot;&gt;&lt;/label&gt;
                                &lt;input type=&quot;text&quot; oninput=&quot;turnOnPwdStyle(this)&quot; class=&quot;login-input col-8&quot; name=&quot;pwd&quot; id=&quot;pwd&quot; onKeyDown=&quot;checkEnt(event)&quot; onChange=&quot;chkRequired()&quot; required=&quot;required&quot;&gt;
                                &lt;a style=&quot;cursor:pointer;&quot;&gt;&amp;nbsp;&amp;nbsp;&lt;img class=&quot;openEyeCss pwdEyeCss&quot;  src=&quot;../images/openEye.png?v=D&quot; onClick=&quot;changeEye(this)&quot;&gt;&lt;/a&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        &lt;div class=&quot;form-group warningText&quot; style=&quot;display:none;margin-top:-16px; max-width:243px;margin-left:78px&quot;&gt;
                            &lt;div style=&quot;float:left&quot;&gt;
                                &lt;img src=&quot;../images/loginErr.png?v=D&quot; style=&quot;width:63%; vertical-align:top; margin-top:6px; margin-right:-2px&quot;&gt;
                            &lt;/div&gt;
                            &lt;div style=&quot;overflow: hidden;&quot;&gt;
                                &lt;label class=&quot;trn warningDesc&quot; style=&quot;color:#fb69a3;&quot;&gt;&lt;/label&gt;
                            &lt;/div&gt;
                        &lt;/div&gt;
                        &lt;div class=&quot;form-group&quot;&gt;
                            &lt;button type=&quot;button&quot; class=&quot;trn login-btn&quot; data-trn-key=&quot;LANG_LOGIN_LOGIN&quot; id=&quot;login_word&quot; name=&quot;Login&quot; onclick=&quot;javascript: checkform(this)&quot;&gt;&lt;/button&gt;
                        &lt;/div&gt;
                        &lt;input name=&quot;check&quot; type=&quot;hidden&quot; value=&quot;00&quot;&gt;
                    &lt;/form&gt;
                &lt;div&gt;
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/div&gt;
    &lt;footer&gt;
        &lt;div class=&quot;footer&quot;&gt;
            &lt;div style=&quot;text-align: center; min-width: 300px&quot;&gt;
                Copyright &lt;span id=&quot;copyRightYear&quot;&gt;&lt;/span&gt; Supermicro Computer, Inc.
            &lt;/div&gt;
        &lt;/div&gt;
    &lt;/footer&gt;

    &lt;div class=&quot;modal fade&quot; id=&quot;loginModalCenter&quot; tabindex=&quot;-1&quot; role=&quot;dialog&quot; data-backdrop=&quot;static&quot; data-keyboard=&quot;false&quot; style=&quot;display: none;&quot;&gt;
