<ReportItem port="0" svc_name="general" protocol="tcp" severity="0" pluginID="86420" pluginName="Ethernet MAC Addresses" pluginFamily="General">
<description>This plugin gathers MAC addresses discovered from both remote probing of the host (e.g. SNMP and Netbios) and from running local checks (e.g. ifconfig). It then consolidates the MAC addresses into a single, unique, and uniform list.</description>
<fname>report_hw_macs.nasl</fname>
<plugin_modification_date>2025/06/10</plugin_modification_date>
