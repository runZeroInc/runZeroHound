<ReportItem port="3389" svc_name="ms-wbt-server?" protocol="tcp" severity="3" pluginID="58435" pluginName="MS12-020: Vulnerabilities in Remote Desktop Could Allow Remote Code Execution (2671387) (uncredentialed check)" pluginFamily="Windows">
