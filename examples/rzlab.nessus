        &lt;span class=&quot;floating_element&quot;&gt;
          Apache2 Debian Default Page
        &lt;/span&gt;
      &lt;/div&gt;
&lt;!--      &lt;div class=&quot;table_of_contents floating_element&quot;&gt;
