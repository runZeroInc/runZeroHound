   so we need to change the location */
  if(top != self)
    top.location.href = &quot;/base/cheetah_login.html&quot;;

  /* Function to handle &apos;Enter&apos; key. On the login page, the &quot;Enter&apos; Key press
     should be, taken as a press on login button. Post localization changes, the buttons
     are replaced by hyper links, hence this is necessary */
  function handle_enter(event)
  {
    /* If the pressed key is &apos;Enter&apos;, submit the form. */
    if(event.keyCode == 13)
    {
      event.preventDefault();

      document.getElementById(&apos;login-form&apos;).submit();

    }
  }

  function pausecomp(millis)
  {
    var date = new Date();
    var curDate = null;
    do {
      curDate = new Date();
    }
    while (curDate - date &lt; millis);
  }

  function screen_refresh()
  {
    document.forms[0].elements[&apos;submt&apos;].value = 0x10;
    document.forms[0].submit();
    pausecomp(2000);
  }

  function DisplayErrorMsg()
  //******************************************************************************
