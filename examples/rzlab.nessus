<ReportItem port="443" svc_name="www" protocol="tcp" severity="2" pluginID="77200" pluginName="OpenSSL &apos;ChangeCipherSpec&apos; MiTM Vulnerability" pluginFamily="Misc.">
<age_of_vuln>730 days +</age_of_vuln>
<bid>66363</bid>
