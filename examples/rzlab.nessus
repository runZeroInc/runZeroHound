<plugin_publication_date>2001/08/26</plugin_publication_date>
<plugin_type>combined</plugin_type>
<risk_factor>None</risk_factor>
<script_version>1.57</script_version>
<solution>n/a</solution>
<synopsis>A DCE/RPC service is running on the remote host.</synopsis>
