<ReportItem port="40815" svc_name="unknown" protocol="tcp" severity="0" pluginID="35297" pluginName="SSL Service Requests Client Certificate" pluginFamily="Service detection">
<description>The remote service encrypts communications using SSL/TLS, requests a client certificate, and may require a valid certificate in order to establish a connection to the underlying service.</description>
<fname>ssl_client_cert_requested.nasl</fname>
<plugin_modification_date>2022/04/11</plugin_modification_date>
<plugin_name>SSL Service Requests Client Certificate</plugin_name>
<plugin_publication_date>2009/01/06</plugin_publication_date>
<plugin_type>remote</plugin_type>
<risk_factor>None</risk_factor>
<script_version>1.15</script_version>
<solution>n/a</solution>
<synopsis>The remote service requests an SSL client certificate.</synopsis>
<thorough_tests>true</thorough_tests>
<plugin_output>
