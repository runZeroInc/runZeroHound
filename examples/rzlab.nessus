            &apos;html&apos;: &apos;../html&apos;,
            &apos;platformHtm&apos;: &apos;../platformHtm&apos;,
            &apos;jsCore&apos;: &apos;../jsCore&apos;
        }
    });
    seajs.use(&apos;/jsCore/app&apos;, function(App) {
        window.webApp = new App();
    });&lt;/script&gt; &lt;/body&gt; &lt;/html&gt;</plugin_output>
