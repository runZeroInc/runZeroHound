        &lt;script language=&quot;javascript&quot;&gt;
            function changeBg(i){
                $(&apos;boat_current&apos;).addClass(&apos;ui-boat-current-&apos; + i);
                $(&apos;boat_intellent_current&apos;).addClass(&apos;ui-boat-intel-current-&apos; + i);
            }
            
            function moveBg(i){
                $(&apos;boat_current&apos;).removeClass(&apos;ui-boat-current-&apos; + i);
                $(&apos;boat_intellent_current&apos;).removeClass(&apos;ui-boat-intel-current-&apos; + i);
            }
        &lt;/script&gt;
