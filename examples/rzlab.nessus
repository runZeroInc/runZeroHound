<ReportItem port="21" svc_name="ftp" protocol="tcp" severity="4" pluginID="51956" pluginName="MS11-004: Vulnerability in Internet Information Services (IIS) FTP Service Could Allow Remote Code Execution (2489256) (uncredentialed check)" pluginFamily="Windows">
