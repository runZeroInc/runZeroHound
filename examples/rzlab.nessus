cpe:/a:erlang:erlang%2fotp</cpe>
<cve>CVE-2025-32433</cve>
<cvss3_base_score>10.0</cvss3_base_score>
<cvss3_temporal_score>9.5</cvss3_temporal_score>
<cvss3_temporal_vector>CVSS:3.0/E:H/RL:O/RC:C</cvss3_temporal_vector>
<cvss3_vector>CVSS:3.0/AV:N/AC:L/PR:N/UI:N/S:C/C:H/I:H/A:H</cvss3_vector>
<cvssV3_impactScore>6.0</cvssV3_impactScore>
