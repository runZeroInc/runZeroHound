<ReportItem port="6001" svc_name="X11:1?" protocol="tcp" severity="2" pluginID="65821" pluginName="SSL RC4 Cipher Suites Supported (Bar Mitzvah)" pluginFamily="General">
<age_of_vuln>730 days +</age_of_vuln>
