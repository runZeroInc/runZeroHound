      a.innerHTML = &quot;&lt;label class=\&quot;inlineError inlineEr_paddingSmart\&quot; &gt;&quot; + document.forms[0].err_msg.value + &quot;&lt;/label&gt;&quot;;

      $(&quot;#errLine&quot;).after(a);
    } 
    else
    {
      loginErrorPopUp(document.forms[0].err_msg.value);
    }

  }

  function CheckError()
  {
    var cookieEnabled = false;
    $(&apos;table&apos;).attr(&quot;cellspacing&quot;, 0);
    $(&apos;table&apos;).attr(&quot;cellpadding&quot;, 0);
    document.cookie = &quot;testcookie&quot;;
    cookieEnabled = (document.cookie.indexOf(&quot;testcookie&quot;) != -1) ? true : false;
    if (cookieEnabled == false)
    {
      alert(&quot;Browser does not accept cookies. Please configure your browser to accept cookies in order to access the Web Interface.&quot;);
    }
    if (document.forms[0].err_flag.value == 1)
    {
      DisplayErrorMsg();
    } 


      document.forms[0].pwd.focus();


